<script>
function autoDetectUnfold() {
  document.querySelectorAll('div[onclick="toggleUnfold(this)"]').forEach(container => {
    const raw = container.getAttribute('data-archive');
    if (!raw) return;
    
    const match = raw.match(/^(.+?)-\_(.*?)\-(.+?)\.zip$/);
    if (!match) return;

    container.querySelector('.unfold-name').textContent = match[1];
    container.querySelector('.unfold-desc').textContent = match[2];
    container.querySelector('.unfold-ver').textContent = match[3];
  });
}

function toggleUnfold(element) {
  const content = element.querySelector('.unfold-content');
  const arrow = element.querySelector('.unfold-arrow');
  const isOpen = content.style.gridTemplateRows === '1fr';
  
  content.style.gridTemplateRows = isOpen ? '0fr' : '1fr';
  arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(90deg)';
}

autoDetectUnfold();
</script>
